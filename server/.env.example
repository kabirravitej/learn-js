PORT=3847

# Google Apps Script web app URL (.../macros/s/XXXX/exec)
# On Vercel: set the same vars in Project → Settings → Environment Variables
GAS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec

# Optional shared secret your Apps Script checks
GAS_SECRET=some-long-random-string

# POST (JSON body) or GET (query params)
GAS_METHOD=POST

ALLOW_CONSOLE_OTP=false
